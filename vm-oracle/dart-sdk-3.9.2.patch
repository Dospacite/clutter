+// Static-call targets: every Code object referenced by the global object
+// pool. In precompiled snapshots per-Code static_calls_target_table arrays
+// are dropped (NOT_IN_PRECOMPILED), but call targets remain reachable as
+// pool entries, so the pool is the authoritative static-call evidence.
+void SnapshotAnalyzer::DumpStaticCallTargets() {
+  js_.OpenObject("static_calls");
+  js_.PrintProperty("type", "StaticCalls");
+  const ObjectPool& pool =
+      ObjectPool::Handle(thread_->isolate_group()->object_store()
+                             ->global_object_pool());
+  int64_t entry_count = 0;
+  if (!pool.IsNull()) {
+    const uint64_t instruction_base =
+        reinterpret_cast<uint64_t>(info_.vm_isolate_instructions);
+    js_.OpenArray("targets");
+    Zone* zone = thread_->zone();
+    Object& entry = Object::Handle(zone);
+    for (intptr_t i = 0; i < pool.Length(); ++i) {
+      if (pool.TypeAt(i) != ObjectPool::EntryType::kTaggedObject) continue;
+      entry = pool.ObjectAt(i);
+      if (!entry.IsCode()) continue;
+      const auto& target_code = Code::Cast(entry);
+      if (target_code.IsUnknownDartCode()) continue;
+      ++entry_count;
+      js_.OpenObject();
+      js_.PrintProperty64("pool_index", i);
+      js_.PrintProperty64(
+          "target_offset",
+          static_cast<int64_t>(static_cast<uint64_t>(target_code.PayloadStart()) -
+                               instruction_base));
+      js_.PrintProperty64("size",
+                          static_cast<int64_t>(target_code.Size()));
+      const auto& owner = Object::Handle(zone, target_code.owner());
+      if (!owner.IsNull()) {
+        js_.PrintProperty64("owner_id", GetObjectId(owner.ptr()));
+        if (owner.IsFunction()) {
+          const auto& owner_function = Function::Cast(owner);
+          js_.PrintProperty(
+              "owner_name",
+              String::Handle(zone, owner_function.name()).ToCString());
+          js_.PrintPropertyBool("owner_is_static", owner_function.is_static());
+          js_.PrintProperty64("owner_parameter_count",
+                              owner_function.NumParameters());
+        }
+      }
+      js_.CloseObject();
+    }
+    js_.CloseArray();
+  }
+  js_.PrintProperty64("entry_count", entry_count);
+  js_.CloseObject();
+}
