+// Dispatch metadata: selector index -> Code entry array. The analyzer runs in
+// a precompiled runtime, where the dispatch table is materialized from this
+// array at snapshot load; emitting it preserves receiver-CID dispatch facts.
+void SnapshotAnalyzer::DumpDispatchMetadata() {
+  js_.OpenObject("dispatch_metadata");
+  js_.PrintProperty("type", "Dispatch");
+  const Array& entries =
+      Array::Handle(thread_->isolate_group()->object_store()
+                        ->dispatch_table_code_entries());
+  if (!entries.IsNull()) {
+    js_.PrintProperty64("code_entry_count", entries.Length());
+    const uint64_t instruction_base =
+        reinterpret_cast<uint64_t>(info_.vm_isolate_instructions);
+    js_.OpenArray("targets");
+    Zone* zone = thread_->zone();
+    Code& code = Code::Handle(zone);
+    for (intptr_t i = 0; i < entries.Length(); ++i) {
+      code ^= entries.At(i);
+      if (code.IsNull()) continue;
+      if (code.IsUnknownDartCode()) continue;
+      js_.OpenObject();
+      js_.PrintProperty64("selector_index", i);
+      js_.PrintProperty64(
+          "target_offset",
+          static_cast<int64_t>(static_cast<uint64_t>(code.PayloadStart()) -
+                               instruction_base));
+      js_.PrintProperty64("size", static_cast<int64_t>(code.Size()));
+      const auto& owner = Object::Handle(zone, code.owner());
+      if (!owner.IsNull()) {
+        js_.PrintProperty64("owner_id", GetObjectId(owner.ptr()));
+        if (owner.IsFunction()) {
+          js_.PrintProperty(
+              "owner_name",
+              String::Handle(zone, Function::Cast(owner).name()).ToCString());
+        }
+      }
+      js_.CloseObject();
+    }
+    js_.CloseArray();
+  } else {
+    js_.PrintProperty64("code_entry_count", 0);
+  }
+  js_.CloseObject();
+}
