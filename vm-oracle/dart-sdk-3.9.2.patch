+// Populated CID runs from the live class table. Obfuscation renames classes
+// but cannot compact CIDs, so [start, end] runs are stable identity evidence.
+void SnapshotAnalyzer::DumpClassIdRanges() {
+  js_.OpenObject("class_ranges");
+  js_.PrintProperty("type", "ClassRanges");
+  auto class_table = thread_->isolate_group()->class_table();
+  const intptr_t num_cids = class_table->NumCids();
+  const intptr_t num_top_level = class_table->NumTopLevelCids();
+  js_.PrintProperty64("num_cids", num_cids);
+  js_.PrintProperty64("num_top_level_cids", num_top_level);
+  // Top-level CIDs start at ClassTable::kTopLevelCidOffset; walking the full
+  // [0, NumCids + NumTopLevelCids) space keeps runs contiguous across both.
+  js_.OpenArray("populated_runs");
+  bool open_run = false;
+  intptr_t run_start = -1;
+  const intptr_t total_cids =
+      num_cids + (num_top_level > 0 ? num_top_level : 0);
+  for (intptr_t cid = 0; cid < total_cids; ++cid) {
+    const bool valid = class_table->IsValidIndex(cid) &&
+                       class_table->HasValidClassAt(cid);
+    if (valid && !open_run) {
+      run_start = cid;
+      open_run = true;
+    } else if (!valid && open_run) {
+      js_.PrintValue64(run_start);
+      js_.PrintValue64(cid - 1);
+      open_run = false;
+    }
+  }
+  if (open_run) {
+    js_.PrintValue64(run_start);
+    js_.PrintValue64(total_cids - 1);
+  }
+  js_.CloseArray();
+  js_.CloseObject();
 }
 
